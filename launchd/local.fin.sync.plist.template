<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Modelo. scripts/instalar-launchd.sh troca __PROJECT__, __UV__, __HOME__ e grava em ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.fin.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>__PROJECT__/scripts/sync-diario.sh</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>PYTHONUNBUFFERED</key><string>1</string>
    <key>FIN_CONFIG</key><string>__PROJECT__/config.yaml</string>
    <key>FIN_LOG_FILE</key><string>__HOME__/Library/Logs/fin/sync.log</string>
    <!-- prazo interno do sync (s): passou disso, sai com código 124 (fin doctor mostra) -->
    <key>FIN_SYNC_TIMEOUT</key><string>1800</string>
    <key>FIN_UV</key><string>__UV__</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>30</integer></dict>
  <!-- Recuperação: Mac desligado às 11:30 ou cofre fechado. O script só roda o sync se ainda não houve sucesso hoje. -->
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/fin/sync.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/fin/sync.err.log</string>
</dict>
</plist>
